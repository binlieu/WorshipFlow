 "ignore_design": [
  {
   "match": "^div\\.tb\\[0\\]>div\\.lights",
   "reason": "the window's three controls are the system's (grey in the capture: the window is not key)"
  },
  {
   "match": "(^|>)svg\\.i",
   "reason": "icon glyph box: SF Symbols draw to their own metrics; the control that contains the icon is compared"
  },
  {
   "match": "^div\\.tb\\[0\\]>div\\.col\\[1\\]$",
   "reason": "wrapper of the title and subtitle, which are compared"
  },
  {
   "match": "^div\\.body\\[1\\]$|^div\\.body\\[1\\]>div\\.side\\.r\\[2\\]>div\\.sec(\\.grow)?\\[\\d\\]$|>div\\.strip\\[1\\]$|>div\\.sec\\[0\\]$",
   "reason": "column or section wrapper: its position follows from the rows and paddings inside, which are compared (the filmstrip's strip is as tall as its content, the app's scrolls)"
  },
  {
   "match": "div\\.cap\\[0\\]$",
   "reason": "the number line of a filmstrip cell: its number is compared, the line has no drawn edge"
  },
  {
   "match": "div\\.thumb[^>]*\\[1\\]>div\\.l[12]",
   "reason": "slide picture content (the words in a thumbnail) is drawn by the output renderer, not by the interface (UI-005h)"
  },
  {
   "match": "div\\.bar\\[0\\]>(span\\.btn\\[3\\]|span\\[4\\]|span\\.btn\\[5\\]|div\\.seg\\[0\\]|span\\.field\\[8\\])",
   "reason": "LEFT OUT, feature missing (L/M rows E12, E14, E16, E17): Video object, Align, the Audience / Stage / Broadcast preview switch and Zoom; their room is kept in the bar"
  },
  {
   "match": "div\\.row\\[1\\]>span\\.c-muted\\[2\\]$",
   "reason": "LEFT OUT (E19): 'Saved 2 s ago' needs a last-saved time on the editor model (not observed, so not drawn)"
  },
  {
   "match": "div\\.cv\\[0\\]>div\\.box\\[2\\]",
   "reason": "LEFT OUT: the design's second lyric box; the words are the theme's, not objects, so only the selected object's box is drawn"
  },
  {
   "match": "div\\.cv\\[0\\]>div\\.box\\[1\\]>div\\[0\\]$",
   "reason": "picture content: the box's text is drawn by the compositor"
  },
  {
   "match": "div\\.fr\\[5\\]",
   "reason": "LEFT OUT, feature missing (L row E35): Fit ('Shrink to fit box'); the row's room is kept"
  },
  {
   "match": "div\\.sec\\[2\\]>div\\.fr\\[3\\]",
   "reason": "LEFT OUT, feature missing (L row E38): Background fill for text; the row's room is kept"
  },
  {
   "match": "div\\.sec\\.grow\\[4\\]",
   "reason": "LEFT OUT, feature missing (L row E40): the Layers list (objects have no names, hidden flag or roles; props and background are not objects)"
  },
  {
   "match": "div\\.sec\\[3\\]>div\\[1\\]>span\\.field\\.mono\\[\\d\\]>span\\.c-muted",
   "reason": "the X, Y, W, H prefix inside a compared field"
  },
  {
   "match": "div\\.sec\\[1\\]>div\\.fr\\[\\d\\]>span\\.field\\[0\\]>span\\.car",
   "reason": "the field's chevron wrapper; the field is compared"
  },
  {
   "match": "^div\\.tb\\[0\\]>span\\.pill[^>]*>span\\.d\\[0\\]$",
   "reason": "the status dot inside a toolbar pill: the pill is compared"
  }
 ],
 "ignore_app": [
  {
